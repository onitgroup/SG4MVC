<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net10.0</TargetFrameworks>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<NoWarn>1701;1702;1591</NoWarn>
	</PropertyGroup>

	<PropertyGroup>
		<PackageId>SG4MVC-Onit</PackageId>
		<Authors>Mark Flanagan, Kevin Kuszyk, Scott Mackay, Artiom Chilaru</Authors>
		<PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
		<PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
		<PackageProjectUrl>https://github.com/SG4MVC/SG4MVC</PackageProjectUrl>
		<RepositoryUrl>https://github.com/SG4MVC/SG4MVC</RepositoryUrl>
		<Title>SG4MVC</Title>
		<Description>Runtime helpers used by code generated by Sg4Mvc.Generator</Description>
		<PackageTags>aspnetcore;mvc;r4mvc;source generator;sg4mvc</PackageTags>
		<VersionPrefix>1.0.0</VersionPrefix>
		<!-- Leaving the assembly version static, to prevent assembly binding and assembly redirect issues.
    Only the major version will ever be updated -->
		<AssemblyVersion>1.0.0.0</AssemblyVersion>
		<PackageReleaseNotes>
			+ Do not generate parameter for CancellationToken
			+ Settings file : sg4mvc.json
			+ Conditional generation of the Sg4Mvc (enabled in settings file RunOnlyOnCondition) via msbuild parameter, example : "dotnet build -p:RunSg4Mvc=true --no-incremental"
		</PackageReleaseNotes>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)'=='Release'">
		<IsPackable>true</IsPackable>
		<ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
		<DebugType>embedded</DebugType>
	</PropertyGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
		<PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.3.0" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\Sg4Mvc.Generator\Sg4Mvc.Generator.csproj" PrivateAssets="all" />
	</ItemGroup>

	<ItemGroup>
		<None Include="$(OutputPath)\net10.0\Sg4Mvc.Generator.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
		<None Include="build\SG4MVC-Onit.props" Pack="true" PackagePath="build\" Visible="false" />
	</ItemGroup>

</Project>
