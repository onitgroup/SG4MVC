<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net6.0;net8.0;net10.0</TargetFrameworks>
		<GenerateDocumentationFile>true</GenerateDocumentationFile>
		<NoWarn>1701;1702;1591</NoWarn>
	</PropertyGroup>

	<PropertyGroup>
		<PackageId>SG4MVC-Onit</PackageId>
		<Authors>Mark Flanagan, Kevin Kuszyk, Scott Mackay, Artiom Chilaru, Valerio Borioni</Authors>
		<PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
		<PackageLicenseExpression>Apache-2.0</PackageLicenseExpression>
		<PackageProjectUrl>https://github.com/SG4MVC/SG4MVC</PackageProjectUrl>
		<RepositoryUrl>https://github.com/SG4MVC/SG4MVC</RepositoryUrl>
		<Title>SG4MVC</Title>
		<Description>Runtime helpers used by code generated by Sg4Mvc.Generator</Description>
		<PackageTags>aspnetcore;mvc;r4mvc;source generator;sg4mvc</PackageTags>
		<VersionPrefix>2.0.1</VersionPrefix>
		<!-- Leaving the assembly version static, to prevent assembly binding and assembly redirect issues.
    Only the major version will ever be updated -->
		<AssemblyVersion>2.0.1.0</AssemblyVersion>
		<PackageReleaseNotes>
			+ Do not generate parameter for CancellationToken
			+ Settings file : sg4mvc.json
			+ Incremental generation
		</PackageReleaseNotes>
	</PropertyGroup>

	<PropertyGroup Condition="'$(Configuration)'=='Release'">
		<IsPackable>true</IsPackable>
		<ContinuousIntegrationBuild>true</ContinuousIntegrationBuild>
		<EmbedUntrackedSources>true</EmbedUntrackedSources>
		<DebugType>embedded</DebugType>
	</PropertyGroup>

	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\Sg4Mvc.Generator\Sg4Mvc.Generator.csproj" PrivateAssets="all" ReferenceOutputAssembly="false" />
	</ItemGroup>

	<ItemGroup>
		<None Include="..\Sg4Mvc.Generator\bin\$(Configuration)\netstandard2.0\Sg4Mvc.Generator.dll" Pack="true" PackagePath="analyzers/dotnet/cs" Visible="false" />
		<None Include="build\SG4MVC-Onit.props" Pack="true" PackagePath="build\" Visible="false" />
		<None Include="build\SG4MVC.props" Pack="true" PackagePath="build\" Visible="false" />
	</ItemGroup>

</Project>
